# Copy this file to .env and fill in your values. Do not commit .env.

# Google AI
# Vertex AI mode (default): no API key needed. Authenticate with
# `gcloud auth application-default login`.
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
GOOGLE_CLOUD_LOCATION=us-central1

# Gemini API mode (alternative): set GOOGLE_GENAI_USE_VERTEXAI=FALSE and
# uncomment the key below.
# GOOGLE_API_KEY=your-google-api-key-here

# Logging
LOG_LEVEL=INFO
